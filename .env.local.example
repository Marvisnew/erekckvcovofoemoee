# Скопируйте в .env.local (уже готовые значения — общий учебный проект Sanity).
# Пока переменные не заданы — сайт работает на встроенных демо-данных.

NEXT_PUBLIC_SANITY_PROJECT_ID=igi2ju6x
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Необязательно: секрет для мгновенного обновления кэша через вебхук Sanity.
SANITY_REVALIDATE_SECRET=

# Web3Forms для отправки заказов
# 1) Зарегистрируйтесь на https://web3forms.com
# 2) Создайте форму и получите Access Key
# 3) Добавьте debiltupoi52@gmail.com как получателя в настройках формы
# 4) Вставьте ключ сюда и в Vercel → Settings → Environment Variables
WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
ORDER_EMAIL=debiltupoi52@gmail.com
